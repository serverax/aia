# Copy to .env and fill in values for local development.

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synthetic
POSTGRES_USER=synthetic
POSTGRES_PASSWORD=synthetic-dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenTelemetry / Jaeger (OTLP gRPC endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=echo-agent

# Echo Agent
ECHO_INPUT_STREAM=agent:echo:tasks
ECHO_OUTPUT_STREAM=agent:echo:results
ECHO_CONSUMER_GROUP=echo-agents
ECHO_CONSUMER_NAME=echo-agent-1

# LLM (Sprint 2 — Orchestrator + Compliance use Anthropic Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Orchestrator
ORCHESTRATOR_REQUEST_STREAM=orchestrator:requests
ORCHESTRATOR_REPLY_STREAM=orchestrator:replies
ORCHESTRATOR_MAX_CONCURRENT_DISPATCHES=20

# Compliance Officer
COMPLIANCE_INPUT_STREAM=agent:compliance_officer:tasks
COMPLIANCE_RESULT_STREAM=agent:compliance_officer:results
COMPLIANCE_CONSUMER_GROUP=compliance-officers
COMPLIANCE_CONSUMER_NAME=compliance-officer-1
