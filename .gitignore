# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Testing
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml
.tox/

# Env / secrets
.env
.env.*
!.env.example
~/.aia/
*.pem
*.key
cosign.key

# Kubeconfigs / cluster credentials (never commit)
*kubeconfig*
*.kubeconfig
aia-developer-kubeconfig.yaml
openclaw-dev-working.yaml

# Generated secrets / dev env files
secrets*.env
*.secret.env
generated/secrets.dev.env

# Talos PKI / machine configs (CA + bootstrap tokens — NEVER commit).
# NOTE: existing committed copies still require a history scrub — see
# docs/integration/SECRET_INVENTORY_AND_SCRUB_RUNBOOK.md
infrastructure/talos/gen/
*talosconfig*

# Sync backups & editor backups (transient working-tree clutter)
_backup_before_*/
*.save
*.backup
*.backup.*
*.backup-*
*.before-*

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Logs
*.log
provision.log
verify.log
node_modules/
