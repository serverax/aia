{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "input": {
    "type": "object",
    "required": ["text"],
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000,
        "description": "Free text to scan for date references."
      },
      "locale": {
        "type": "string",
        "enum": ["en-GB", "en-US"],
        "default": "en-GB",
        "description": "Disambiguates DD/MM/YYYY vs MM/DD/YYYY."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": ["dates"],
    "properties": {
      "dates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["iso", "raw", "confidence"],
          "properties": {
            "iso": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "raw": { "type": "string" },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
